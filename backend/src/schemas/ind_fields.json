                            "source": null
                        }
                    ]
                }
            ]
        },
        {
            "section_id": "312.23(a)(8)",
            "heading_name": "Pharmacology and toxicology information",
            "subsections": [
                {
                    "subsection_id": "3.12.23(a)(8)(i)",
                    "source_text": "A section describing the pharmacological effects and mechanism(s) of action of the drug in animals, and information on the absorption, distribution, metabolism, and excretion of the drug, if known.",
                    "fields": [
                        {
                            "field_name": "Pharmacological Effects in Animals",
                            "value": null,
                            "status": "present | missing | not_applicable",
                            "required_if": null,
                            "source": null
                        },
                        {
                            "field_name": "Mechanism(s) of Action in Animals",
                            "value": null,
                            "status": "present | missing | not_applicable",
                            "required_if": null,
                            "source": null
                        },
                        {
                            "field_name": "Absorption, Distribution, Metabolism, and Excretion (ADME) Information",
                            "value": null,
                            "status": "present | missing | not_applicable",
                            "required_if": "adme_information_known",
                            "source": null
                        }
                    ]
                },
                {
                    "subsection_id": "3.12.23(a)(8)(ii)(a)",
                    "source_text": "An integrated summary of the toxicological effects of the drug in animals and in vitro. Depending on the nature of the drug and the phase of the investigation, the description is to include the results of acute, subacute, and chronic toxicity tests; tests of the drug's effects on reproduction and the developing fetus; any special toxicity test related to the drug's particular mode of administration or conditions of use (e.g., inhalation, dermal, or ocular toxicology); and any in vitro studies intended to evaluate drug toxicity.",
                    "fields": [
                        {
                            "field_name": "Summary of Toxicological Effects In Vitro",
                            "value": null,
                            "status": "present | missing | not_applicable",
                            "required_if": "in_vitro_toxicology_studies_conducted",
                            "source": null
                        },
                        {
                            "field_name": "Summary of Toxicological Effects in Animals",
                            "value": null,
                            "status": "present | missing | not_applicable",
                            "required_if": "animal_toxicology_studies_conducted",
                            "source": null
                        },
                        {
                            "field_name": "Results of Acute, Subacute, and Chronic Toxicity Tests",
                            "value": null,
                            "status": "present | missing | not_applicable",
                            "required_if": "toxicity_tests_conducted",
                            "source": null
                        },
                        {
                            "field_name": "Results of Reproductive and Developmental Toxicity Tests",
                            "value": null,
                            "status": "present | missing | not_applicable",
                            "required_if": "reproductive_or_developmental_toxicity_tests_conducted",
                            "source": null
                        },
                        {
                            "field_name": "Results of Special Toxicity Tests Related to Mode of Administration or Conditions of Use",
                            "value": null,
                            "status": "present | missing | not_applicable",
                            "required_if": "special_toxicity_tests_conducted",
                            "source": null
                        }
                    ]
                },
                {
                    "subsection_id": "3.12.23(a)(8)(ii)(b)",
                    "source_text": "For each toxicology study that is intended primarily to support the safety of the proposed clinical investigation, a full tabulation of data suitable for detailed review.",
                    "fields": [
                        {
                            "field_name": "Tabulation of Data for Toxicology Study 1",
                            "value": null,
                            "status": "present | missing | not_applicable",
                            "required_if": "toxicology_study_1_intended_to_support_safety_of_proposed_clinical_investigation",
                            "source": null
                        },
                        {
                            "field_name": "Tabulation of Data for Toxicology Study 2",
                            "value": null,
                            "status": "present | missing | not_applicable",
