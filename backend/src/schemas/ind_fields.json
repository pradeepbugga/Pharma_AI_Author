                },
                {
                    "subsection_id": "3.12.23(a)(3)(ii)",
                    "source_text": "A brief summary of previous human experience with the drug, with reference to other IND's if pertinent, and to investigational or marketing experience in other countries that may be relevant to the safety of the proposed clinical investigation(s).",
                    "fields": [
                        {
                            "field_name": "Summary of Prior Human Experience with the Study Drug",
                            "value": null,
                            "status": "present | missing | not_applicable",
                            "required_if": "human_data_available",
                            "source": null
                        },
                        {
                            "field_name": "Status of the Drug in Other Countries",
                            "value": null,
                            "status": "present | missing | not_applicable",
                            "required_if": "drug_approved_in_other_countries",
                            "source": null
                        },
                        {
                            "field_name": "Other INDs Pertinent to Safety of Proposed Clinical Investigations",
                            "value": null,
                            "status": "present | missing | not_applicable",
                            "required_if": "other_inds_pertinent_to_safety",
                            "source": null
                        }
                    ]
                },
                {
                    "subsection_id": "3.12.23(a)(3)(iii)",
                    "source_text": "If the drug has been withdrawn from investigation or marketing in any country for any reason related to safety or effectiveness, identification of the country(ies) where the drug was withdrawn and the reasons for the withdrawal.",
                    "fields": [
                        {
                            "field_name": "Withdrawal Status of the Drug",
                            "value": null,
                            "status": "present | missing | not_applicable",
                            "required_if": "drug_withdrawn_from_market",
                            "source": null
                        },
                        {
                            "field_name": "Reasons for Withdrawal",
                            "value": null,
                            "status": "present | missing | not_applicable",
                            "required_if": "drug_withdrawn_from_market",
                            "source": null
                        }
                    ]
                },
                {
                    "subsection_id": "3.12.23(a)(3)(iv)",
                    "source_text": "A brief description of the overall plan for investigating the drug product for the following year. The plan should include the following: (a) The rationale for the drug or the research study; (b) the indication(s) to be studied; (c) the general approach to be followed in evaluating the drug; (d) the kinds of clinical trials to be conducted in the first year following the submission (if plans are not developed for the entire year, the sponsor should so indicate); (e) the estimated number of patients to be given the drug in those studies; and (f) any risks of particular severity or seriousness anticipated on the basis of the toxicological data in animals or prior studies in humans with the drug or related drugs.",
                    "fields": [
                        {
                            "field_name": "Rationale for the Drug or Research Study",
